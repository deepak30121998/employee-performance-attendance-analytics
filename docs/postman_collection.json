{
  "info": {
    "name": "Employee Performance & Attendance Analytics",
    "description": "Import into Postman, set the `base_url` and `token` collection variables (token comes from POST /login).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/logout"
          }
        },
        {
          "name": "My Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/profile"
          }
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "Create Employee (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/employees",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Hire\",\n  \"email\": \"new.hire@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"employee\",\n  \"department_id\": 1,\n  \"designation\": \"Software Engineer\"\n}"
            }
          }
        },
        {
          "name": "List Employees",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/employees"
          }
        },
        {
          "name": "View Employee",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/employees/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees",
                "1"
              ]
            }
          }
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/employees/2",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"designation\": \"Senior Software Engineer\"\n}"
            }
          }
        },
        {
          "name": "Delete Employee (admin)",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/employees/2"
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Check In",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/attendance/check-in"
          }
        },
        {
          "name": "Check Out",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/attendance/check-out"
          }
        },
        {
          "name": "List Attendance",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/attendance?from=2026-08-01&to=2026-08-31",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "attendance"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-08-01"
                },
                {
                  "key": "to",
                  "value": "2026-08-31"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Performance",
      "item": [
        {
          "name": "Record Score (manager)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/performance",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_id\": 3,\n  \"month\": \"2026-08\",\n  \"score\": 8,\n  \"comment\": \"Great sprint.\"\n}"
            }
          }
        },
        {
          "name": "My/Team Performance History",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/performance"
          }
        }
      ]
    },
    {
      "name": "Import",
      "item": [
        {
          "name": "Upload CSV (admin)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/import",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "List Import Batches",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/import"
          }
        },
        {
          "name": "Import Batch Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/import/1"
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/analytics?month=2026-08",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "analytics"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "2026-08"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Attendance CSV (admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/reports/attendance?from=2026-08-01&to=2026-08-31",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "reports",
                "attendance"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-08-01"
                },
                {
                  "key": "to",
                  "value": "2026-08-31"
                }
              ]
            }
          }
        },
        {
          "name": "Performance CSV (admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/reports/performance?month=2026-08",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "reports",
                "performance"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "2026-08"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}